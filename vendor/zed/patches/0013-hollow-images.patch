+    /// quiet.md: the same image (id, size) without its pixels, for one already
+    /// in the windows' atlases: they never read the pixels again. A window
+    /// that still needs them lists the image in `Window::take_missing_images`.
+    /// Animated images stay whole.
+    pub fn hollow(&self) -> Option<Self> {
+        (self.data.len() == 1).then(|| Self {
+            id: self.id,
+            scale_factor: self.scale_factor,
+            data: SmallVec::new(),
+            hollow: Some(self.size(0)),
+        })
+    }
+
+    /// quiet.md: whether `hollow` made this.
+    pub fn is_hollow(&self) -> bool {
+        self.hollow.is_some()
+    }
+
+    /// quiet.md: pixels per display pixel, so a downscaled decode keeps the
+    /// original's natural size (`render_size`).
+    pub fn with_scale_factor(mut self, scale_factor: f32) -> Self {
+        self.scale_factor = scale_factor;
+        self
+    }
