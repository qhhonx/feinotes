+#[derive(PartialEq)]
+struct NativeTextContext {
+    focus: Option<gpui::FocusId>,
+    origin: usize,
+    text: String,
+    selection: Range<usize>,
 }
 
+impl NativeTextContext {
+    fn matches(&self, handler: &mut PlatformInputHandler) -> bool {
+        if self.focus != handler.focus_id() || !handler.query_accepts_focused_text_input() {
+            return false;
+        }
+        let range = self.origin..self.origin + self.text.encode_utf16().count();
+        let mut actual = None;
+        handler.text_for_range(range.clone(), &mut actual).is_some_and(|text| text == self.text)
+            && actual.is_none_or(|actual| actual == range)
+    }
+
+    fn read(handler: &mut PlatformInputHandler) -> Option<Self> {
+        if !handler.query_accepts_focused_text_input() {
+            return None;
+        }
+        let selection = handler.selected_text_range(false)?.range;
+        let length = handler.text_length_utf16()?;
+        if selection.end > length {
+            return None;
+        }
+        let requested = selection.start.saturating_sub(2048)..selection.end.saturating_add(512).min(length);
+        let mut actual = None;
+        let text = handler.text_for_range(requested.clone(), &mut actual)?;
+        let range = actual.unwrap_or(requested);
+        if selection.start < range.start || selection.end > range.end
+            || range.len() != text.encode_utf16().count()
+        {
+            return None;
+        }
+        Some(Self {
+            focus: handler.focus_id(), origin: range.start, text,
+            selection: selection.start - range.start..selection.end - range.start,
+        })
+    }
+}
+
+fn byte_offset(text: &str, offset_utf16: usize) -> Option<usize> {
+    let mut offset = 0;
+    for (byte, character) in text.char_indices() {
+        if offset == offset_utf16 { return Some(byte); }
+        offset += character.len_utf16();
+    }
+    (offset == offset_utf16).then_some(text.len())
+}
+
+fn text_change<'a>(before: &str, after: &'a str, range: Range<usize>) -> Option<(Range<usize>, &'a str)> {
+    if let (Some(start), Some(end)) = (byte_offset(before, range.start), byte_offset(before, range.end)) {
+        let replacement = (start <= end).then(|| after.strip_prefix(&before[..start])
+            .and_then(|tail| tail.strip_suffix(&before[end..]))).flatten();
+        if let Some(replacement) = replacement {
+            if before == after && (range.is_empty() || replacement.is_empty()) { return None; }
+            return Some((range, replacement));
+        }
+    }
+    if before == after { return None; }
+
+    // UIKit can revise punctuation outside the original selection.
+    let prefix: usize = before.chars().zip(after.chars())
+        .take_while(|(a, b)| a == b).map(|(c, _)| c.len_utf8()).sum();
+    let suffix: usize = before[prefix..].chars().rev().zip(after[prefix..].chars().rev())
+        .take_while(|(a, b)| a == b).map(|(c, _)| c.len_utf8()).sum();
+    let start = before[..prefix].encode_utf16().count();
+    let removed = before[prefix..before.len() - suffix].encode_utf16().count();
+    Some((start..start + removed, &after[prefix..after.len() - suffix]))
+}
