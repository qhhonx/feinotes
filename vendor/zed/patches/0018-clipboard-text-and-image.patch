     use super::*;
 
+    // quiet.md: a private pasteboard, never the user's clipboard.
+    fn add_image(pasteboard: &Pasteboard, image: &Image) {
+        let bytes = NSData::with_bytes(&image.bytes);
+        pasteboard.inner.setData_forType(Some(&bytes), UTType::from(image.format).inner());
+    }
+
+    #[test]
+    fn test_image_with_text_fallback() {
+        let pasteboard = Pasteboard::unique();
+        let text = ClipboardItem::new_string("screenshot.png".into());
+        pasteboard.write(text.clone());
+        let image = Image::from_bytes(ImageFormat::Png, vec![1, 2, 3]);
+        add_image(&pasteboard, &image);
+        let mut expected = text.entries;
+        expected.push(ClipboardEntry::Image(image));
+        assert_eq!(pasteboard.read(), Some(ClipboardItem { entries: expected }));
+    }
+
+    #[test]
+    fn test_png_preferred_over_tiff() {
+        let pasteboard = Pasteboard::unique();
+        let tiff = Image::from_bytes(ImageFormat::Tiff, vec![4, 5, 6]);
+        pasteboard.write(ClipboardItem { entries: vec![ClipboardEntry::Image(tiff.clone())] });
+        assert_eq!(pasteboard.read(), Some(ClipboardItem { entries: vec![ClipboardEntry::Image(tiff)] }));
+        let png = Image::from_bytes(ImageFormat::Png, vec![1, 2, 3]);
+        add_image(&pasteboard, &png);
+        assert_eq!(pasteboard.read(), Some(ClipboardItem { entries: vec![ClipboardEntry::Image(png)] }));
+    }
+
+    #[test]
+    fn test_empty_image_falls_back_to_text() {
+        let pasteboard = Pasteboard::unique();
+        let text = ClipboardItem::new_string("text".into());
+        pasteboard.write(text.clone());
+        add_image(&pasteboard, &Image::from_bytes(ImageFormat::Png, vec![]));
+        assert_eq!(pasteboard.read(), Some(text));
+    }
