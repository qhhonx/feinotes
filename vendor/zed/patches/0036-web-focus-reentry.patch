gpui_web: browser focus / blur events can fire synchronously inside GPUI's handling of another event (a pointerdown that focuses the IME mirror, a host page moving focus into the frame), and refreshing the window's active status there re-entered the window update: 'attempted to read a window that is already on the stack', after which the app stopped drawing and taking input. Refresh the active status on the next task instead.

diff --git a/crates/gpui_web/src/events.rs b/crates/gpui_web/src/events.rs
index 96fb38361732f081bfb4765adef968740300f2a0..fce1f64e5530a17214b0c996e509bf5b7e00e107 100644
--- a/crates/gpui_web/src/events.rs
+++ b/crates/gpui_web/src/events.rs
@@ -1182,7 +1182,10 @@ impl WebWindowInner {
                 if this.suppress_focus_status_events.get() {
                     return;
                 }
-                this.refresh_active_status();
+                // a focus change can fire synchronously inside GPUI's own handling of an
+                // event (a pointerdown that focuses the IME mirror, a host page moving
+                // focus into this frame): refresh after this task, not re-entrantly
+                this.refresh_active_status_later();
             },
         )
     }
@@ -1196,7 +1199,10 @@ impl WebWindowInner {
                 if this.suppress_focus_status_events.get() {
                     return;
                 }
-                this.refresh_active_status();
+                // a focus change can fire synchronously inside GPUI's own handling of an
+                // event (a pointerdown that focuses the IME mirror, a host page moving
