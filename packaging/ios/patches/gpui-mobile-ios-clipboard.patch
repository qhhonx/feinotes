+// Copy supported data while UIKit owns the pasteboard object.
+unsafe fn pasteboard_data(pasteboard: *mut AnyObject, flavor: &std::ffi::CStr) -> Option<Vec<u8>> {
+    unsafe {
+        let key: *mut AnyObject = msg_send![class!(NSString), stringWithUTF8String: flavor.as_ptr()];
+        let data: *mut AnyObject = msg_send![pasteboard, dataForPasteboardType: key];
+        if data.is_null() { return None; }
+        let length: usize = msg_send![data, length];
+        if length == 0 || length > 64 * 1024 * 1024 { return None; }
+        let raw: *const std::ffi::c_void = msg_send![data, bytes];
+        let bytes = raw.cast::<u8>();
+        (!bytes.is_null()).then(|| std::slice::from_raw_parts(bytes,length).to_vec())
+    }
+}
