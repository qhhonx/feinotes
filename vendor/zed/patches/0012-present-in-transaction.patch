+    fn draw_in_transaction(&self, scene: &gpui::Scene) {
+        let mut this = self.0.lock();
+        let was = this.renderer.presents_with_transaction();
+        this.renderer.set_presents_with_transaction(true);
+        this.renderer.draw(scene);
+        this.renderer.set_presents_with_transaction(was);
+    }
