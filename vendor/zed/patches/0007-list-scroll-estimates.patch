+    /// quiet.md: (scroll offset, content height, viewport height) for a
+    /// scrollbar. Only items that have been on screen are measured, so every
+    /// other one counts at the average measured height.
+    pub fn estimated_scroll_metrics(&self) -> (Pixels, Pixels, Pixels) {
+        let state = self.0.borrow();
+        let bounds = state.last_layout_bounds.unwrap_or_default();
+        let padding = state.last_padding.unwrap_or_default();
+        let total = state.items.summary();
+        let avg = state.average_item_height();
+        let top = state.logical_scroll_top();
+        let mut cursor = state.items.cursor::<ListItemSummary>(());
+        let before: ListItemSummary = cursor.summary(&Count(top.item_ix), Bias::Right);
+        let offset = before.height + avg * before.unrendered_count as f32 + top.offset_in_item;
+        let content =
+            total.height + avg * total.unrendered_count as f32 + padding.top + padding.bottom;
+        (offset, content, bounds.size.height)
+    }
+
+    /// quiet.md: scroll so the estimated `offset` (see
+    /// `estimated_scroll_metrics`) is at the top of the viewport.
+    pub fn scroll_to_estimated_offset(&self, offset: Pixels) {
+        let top = {
+            let state = self.0.borrow();
+            let avg = state.average_item_height();
+            let count = state.items.summary().count;
+            let mut y = px(0.);
+            let mut top = ListOffset::default();
+            for (ix, item) in state.items.iter().enumerate() {
+                let h = item.size().map_or(avg, |s| s.height);
+                if y + h > offset || ix + 1 == count {
+                    top = ListOffset {
+                        item_ix: ix,
+                        offset_in_item: (offset - y).max(px(0.)).min(h),
+                    };
+                    break;
+                }
+                y += h;
+            }
+            top
+        };
+        self.scroll_to(top);
+    }
