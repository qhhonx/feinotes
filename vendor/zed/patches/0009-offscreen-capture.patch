     /// Renders the current frame's scene to a texture and returns the pixel data as an RGBA image.
     /// This does not present the frame to screen - useful for visual testing where we want
     /// to capture what would be rendered without displaying it or requiring the window to be visible.
-    #[cfg(any(test, feature = "test-support"))]
+    // quiet.md: also outside tests, for scripted captures (devtools).
     pub fn render_to_image(&self) -> anyhow::Result<image::RgbaImage> {
         self.platform_window
             .render_to_image(&self.rendered_frame.scene)
     }
 
+    /// quiet.md: runs pending next-frame callbacks, draws a frame and renders
+    /// it offscreen without presenting. Works while the display link is
+    /// stopped (occluded window, locked screen). For scripted captures.
+    pub fn render_offscreen(&mut self, cx: &mut App) -> anyhow::Result<image::RgbaImage> {
+        let callbacks = self.next_frame_callbacks.take();
+        for callback in callbacks {
+            callback(self, cx);
+        }
+        let arena_clear_needed = self.draw(cx);
+        let image = self.render_to_image();
+        arena_clear_needed.clear(cx);
+        image
+    }
+
+    /// quiet.md: whether something was invalidated since the last frame was drawn.
+    pub fn needs_draw(&self) -> bool {
+        self.invalidator.is_dirty()
+    }
+
