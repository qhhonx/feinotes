+    /// quiet.md: like [`Self::load`] without an `App`: keystrokes are parsed
+    /// for `os` and not mapped to the keyboard layout (GPUI 0.2's `load` with
+    /// a `DummyKeyboardMapper`, which the app's Windows and Linux key
+    /// bindings and the user's shortcuts were built with).
+    pub fn load_unmapped(
+        keystrokes: &str,
+        action: Box<dyn Action>,
+        context_predicate: Option<Rc<KeyBindingContextPredicate>>,
+        action_input: Option<SharedString>,
+        os: crate::OperatingSystem,
+    ) -> std::result::Result<Self, InvalidKeystrokeError> {
+        Self::load_internal(
+            keystrokes,
+            action,
+            context_predicate,
+            false,
+            action_input,
+            &DummyKeyboardMapper,
+            |source| Keystroke::parse_with_os(source, os),
+        )
+    }
