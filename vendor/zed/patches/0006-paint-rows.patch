+/// quiet.md: distance from row `row_ix` to the next one: uniform rows unless
+/// explicit row tops are given (rows grown by inline objects).
+fn row_step(row_tops: &[Pixels], row_ix: usize, line_height: Pixels) -> Pixels {
+    match (row_tops.get(row_ix), row_tops.get(row_ix + 1)) {
+        (Some(a), Some(b)) => *b - *a,
+        _ => line_height,
+    }
+}
