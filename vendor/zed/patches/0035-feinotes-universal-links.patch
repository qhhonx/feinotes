+// Fei Notes: CloudKit invitation links can arrive as universal-link activities.
+extern "C-unwind" fn continue_user_activity(this: &AnyObject, _: Sel, app: *mut AnyObject, activity: *mut AnyObject, _: *mut AnyObject) -> Bool {
+    unsafe {
+        if activity.is_null() { return Bool::NO; }
+        let kind: *mut AnyObject = msg_send![activity, activityType];
+        if kind.is_null() { return Bool::NO; }
+        let kind: *const std::ffi::c_char = msg_send![kind, UTF8String];
+        if kind.is_null() || CStr::from_ptr(kind).to_bytes() != b"NSUserActivityTypeBrowsingWeb" { return Bool::NO; }
+        let url: *mut AnyObject = msg_send![activity, webpageURL];
+        if url.is_null() { return Bool::NO; }
+        let urls: *mut AnyObject = msg_send![class!(NSArray), arrayWithObject: url];
+        open_urls(this, sel!(application:openURLs:), app, urls);
+        Bool::YES
+    }
+}
