+fn font_properties(font: &FontKitFont) -> font_kit::properties::Properties {
+    let native = font.native_font();
+    let traits = native.all_traits();
+    // iPadOS 17 can omit numeric traits. FontKit assumes all of them exist.
+    let complete = unsafe {
+        [kCTFontSymbolicTrait, kCTFontWidthTrait, kCTFontWeightTrait, kCTFontSlantTrait]
+            .into_iter()
+            .all(|key| traits.find(key).is_some_and(|value| value.downcast::<CFNumber>().is_some()))
+    };
+    if complete {
+        return font.properties();
+    }
+    let symbolic = native.symbolic_traits();
+    font_kit::properties::Properties {
+        style: if symbolic.is_italic() { FontkitStyle::Italic } else { FontkitStyle::Normal },
+        weight: if symbolic.is_bold() { FontkitWeight::BOLD } else { FontkitWeight::NORMAL },
+        ..Default::default()
+    }
+}
