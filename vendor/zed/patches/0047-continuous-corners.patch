 // Implementation of quad signed distance field
-float quad_sdf_impl(float2 corner_center_to_point, float corner_radius) {
+// Continuous corners (as Apple draws them): a corner of radius r starts
+// 1.528 r from the corner instead of r, and is a superellipse
+// |x|^n + |y|^n = e^n in that e × e box, its exponent chosen so the curve
+// crosses the diagonal where the circle of radius r does. The curvature thus
+// eases in from the straight sides instead of jumping. When the box has to
+// shrink to fit (a pill), n falls back towards 2, the circle.
+// Returns (e, n).
+float2 continuous_corner(float corner_radius, float2 half_size) {
+    if (corner_radius <= 0.0) {
+        return float2(0.0, 2.0);
+    }
+    float e = max(corner_radius, min(corner_radius * 1.528, min(half_size.x, half_size.y)));
+    float n = -1.0 / log2(1.0 - (1.0 - M_SQRT1_2_F) * corner_radius / e);
+    return float2(e, max(n, 2.0));
+}
+
+// Implementation of quad signed distance field. `corner_radius` is the
+// corner's box and `n` its exponent (2: a circular corner).
+float quad_sdf_impl(float2 corner_center_to_point, float corner_radius, float n) {
     if (corner_radius == 0.0) {
         // Fast path for unrounded corners
         return max(corner_center_to_point.x, corner_center_to_point.y);
-    } else {
-        // Signed distance of the point from a quad that is inset by corner_radius
-        // It is negative inside this quad, and positive outside
-        float signed_distance_to_inset_quad =
-            // 0 inside the inset quad, and positive outside
-            length(max(float2(0.0), corner_center_to_point)) +
-            // 0 outside the inset quad, and negative inside
-            min(0.0, max(corner_center_to_point.x, corner_center_to_point.y));
-
-        return signed_distance_to_inset_quad - corner_radius;
     }
+    float2 q = max(float2(0.0), corner_center_to_point);
+    // 0 outside the inset quad, and negative inside
+    float inside = min(0.0, max(corner_center_to_point.x, corner_center_to_point.y));
+    if (q.x == 0.0 || q.y == 0.0) {
+        return max(q.x, q.y) + inside - corner_radius;
+    }
+    // The p-norm, divided by its gradient's length so it stays a distance
+    // near the edge and antialiasing keeps a one-pixel width.
+    float2 qn = pow(q / corner_radius, float2(n));
+    float norm = corner_radius * pow(qn.x + qn.y, 1.0 / n);
+    float2 g = pow(q / norm, float2(n - 1.0));
+    return (norm - corner_radius) / max(length(g), 1e-4) + inside;
