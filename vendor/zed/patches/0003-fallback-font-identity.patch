+    /// in PingFang.ttc), so keep them all and tell them apart by glyph count.
+    font_ids_by_postscript_name: HashMap<String, SmallVec<[FontId; 2]>>,
     font_ids_by_font_key: HashMap<FontKey, SmallVec<[FontId; 4]>>,
