+    // quiet.md: Korean wraps by word; Chinese by character, keeping closing
+    // punctuation with what precedes it; right-to-left words stay whole.
+    #[test]
+    fn test_break_indices_quiet_md() {
+        let breaks = |text: &str| -> Vec<usize> {
+            LineWrapper::break_indices(text).filter(|&ix| ix > 0 && ix < text.len()).collect()
+        };
+        assert_eq!(breaks("한국어 문서를 편집합니다"), ["한국어 ".len(), "한국어 문서를 ".len()]);
+        assert_eq!(breaks("Quiet.md를 써요"), ["Quiet.md를 ".len()]);
+        assert_eq!(breaks("ㅋㅋㅋ 좋아요"), ["ㅋㅋㅋ ".len()]);
+        assert_eq!(breaks("你好世界"), [3, 6, 9]);
+        assert_eq!(breaks("中文。한국어"), [3, "中文。".len()]);
+        assert_eq!(breaks("（注意）你好！"), ["（注".len(), "（注意）".len(), "（注意）你".len()]);
+        assert_eq!(breaks("تحديث البرنامج"), ["تحديث ".len()]);
+        assert_eq!(breaks("שלום עולם"), ["שלום ".len()]);
+    }
+
